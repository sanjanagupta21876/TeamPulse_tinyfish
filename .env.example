# TeamPulse Configuration

# TinyFish API Key (from https://www.tinyfish.ai/)
# Free tier provides fast search and clean web page fetch
# Leave empty to run in transparent offline DEMO MODE with curated guidance
TINYFISH_API_KEY=

# Database Connection (SQLite default)
DATABASE_URL=sqlite:///./teampulse.db

# Optional LLM API Key (if using custom LLM reasoning)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173
